<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Theme for MainActivity -->
    <style name="MainActivityTheme.Starting" parent="Theme.AppCompat.Light">
        <!-- Customize your theme for the main activity here -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Theme for WearableActivity -->
    <style name="WearableActivityTheme.Starting" parent="Theme.AppCompat.Light">
        <!-- Customize your theme for the wearable activity here -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>