<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo circular -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#000000" /> <!-- Color negro para el borde -->
        </shape>
    </item>

    <!-- Contenido interior (imagen) -->
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" /> <!-- Color blanco para el fondo interior -->
        </shape>
    </item>

</layer-list>